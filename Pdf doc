      const t = safeText(f, a.text), tw = f.widthOfTextAtSize(t, a.size); const [tx, ty] = L2P(X, Y, a.rot, (a.w - tw) / 2, a.h / 2 + a.size * .35);
      pg.drawText(t, {x:tx, y:ty, size:a.size, font:f, color:col, rotate:L.degrees(a.rot)}); break; }
    case 'image': { const im = await embImg(a.img); const [X, Y] = toP(a.x, a.y); const [bx, by] = L2P(X, Y, a.rot, 0, a.h);
      pg.drawImage(im, {x:bx, y:by, width:a.w, height:a.h, rotate:L.degrees(a.rot)}); break; }
  }
}
async function drawExtrasPdf(pg, p, toP, font, i, total) {
  if (S.wm.text) { const f = await font('HelveticaBold'), t = safeText(f, S.wm.text), tw = f.widthOfTextAtSize(t, S.wm.size), R = T(p) + 45;
    const [X, Y] = toP(p.W / 2, p.H / 2); const [x, y] = L2P(X, Y, R, -tw / 2, S.wm.size * .35);
    pg.drawText(t, {x, y, size:S.wm.size, font:f, color:hexRgb(S.wm.color), opacity:S.wm.opacity, rotate:L.degrees(R)}); }
  if (S.pn.mode !== 'off') { const f = await font('Helvetica'), t = pnText(i, total), tw = f.widthOfTextAtSize(t, 10);
    const [Dw, Dh] = dims(p); const [cu, cv] = d2u(p, Dw / 2, Dh - 22); const [X, Y] = toP(cu, cv); const [x, y] = L2P(X, Y, T(p), -tw / 2, 3.5);
    pg.drawText(t, {x, y, size:10, font:f, color:L.rgb(.2, .2, .2), rotate:L.degrees(T(p))}); }
}
function addNote(out, pg, a, toP) {
  const [x, y] = toP(a.x, a.y), ctx = out.context;
  const dict = ctx.obj({Type:'Annot', Subtype:'Text', Rect:[x, y - 22, x + 22, y], Contents:L.PDFHexString.fromText(a.text || ''), T:L.PDFHexString.fromText(S.meta.author || 'Comment'), Name:'Comment', C:[1, .83, .23], F:4, Open:false});
