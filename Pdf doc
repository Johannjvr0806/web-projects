<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Folio PDF Editor</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Instrument+Sans:wght@400;500;600;700&family=Caveat:wght@600&family=Homemade+Apple&display=swap" rel="stylesheet">
<style>
:root{
  --desk:#d8dde3; --chrome:#f8f9fb; --chrome2:#eef1f4; --ink:#17202a; --muted:#5b6774; --line:#cad1d9;
  --accent:#f6c915; --accent-ink:#17202a; --focus:#2457e6; --danger:#c62828; --hover:rgba(23,32,42,.07);
  --shadow:0 1px 2px rgba(23,32,42,.2),0 10px 28px rgba(23,32,42,.13);
  color-scheme:light;
  box-sizing:border-box; padding-top:env(safe-area-inset-top,0px); padding-bottom:env(safe-area-inset-bottom,0px);
}
@media (prefers-color-scheme: dark){
  :root:not([data-theme="light"]){
    --desk:#1b2127; --chrome:#252c33; --chrome2:#2d353d; --ink:#e6eaee; --muted:#9aa6b2; --line:#3a444e;
    --focus:#7aa2ff; --danger:#ff8a80; --hover:rgba(255,255,255,.08); --shadow:0 1px 2px rgba(0,0,0,.5),0 10px 28px rgba(0,0,0,.4);
    color-scheme:dark;
  }
}
:root[data-theme="dark"]{
  --desk:#1b2127; --chrome:#252c33; --chrome2:#2d353d; --ink:#e6eaee; --muted:#9aa6b2; --line:#3a444e;
  --focus:#7aa2ff; --danger:#ff8a80; --hover:rgba(255,255,255,.08); --shadow:0 1px 2px rgba(0,0,0,.5),0 10px 28px rgba(0,0,0,.4);
  color-scheme:dark;
}
*,*::before,*::after{box-sizing:inherit}
html{height:100%;background:var(--chrome)}
body{margin:0;height:100%;display:flex;flex-direction:column;overflow:hidden;background:var(--chrome);color:var(--ink);
  font:14px/1.4 "Instrument Sans",system-ui,-apple-system,"Segoe UI",Roboto,sans-serif}
button,input,select,textarea{font:inherit;color:inherit}
button{cursor:pointer}
:focus-visible{outline:2px solid var(--focus);outline-offset:2px}
[hidden]{display:none!important}
svg{width:20px;height:20px;fill:none;stroke:currentColor;stroke-width:1.6;stroke-linecap:round;stroke-linejoin:round;flex:none}

/* header */
.top{display:flex;align-items:center;gap:6px;padding:8px 10px;border-bottom:1px solid var(--line);min-width:0}
.brand{font-weight:700;font-size:17px;letter-spacing:-.01em;padding:0 4px 0 2px;display:flex;align-items:center;gap:7px}
.brand i{display:inline-block;width:12px;height:16px;background:var(--accent);border-radius:2px;transform:skewX(-12deg)}
.docname{min-width:60px;width:220px;flex:0 1 220px;border:1px solid transparent;background:transparent;border-radius:6px;padding:6px 8px;font-weight:500;text-overflow:ellipsis}
.docname:hover{border-color:var(--line)}
.docname:focus{border-color:var(--focus);outline:none;background:var(--chrome2)}
.spacer{flex:1}
.hgrp{display:flex;align-items:center}
.ib{display:inline-flex;align-items:center;justify-content:center;width:36px;height:36px;border:0;border-radius:8px;background:transparent;padding:0}
.ib:hover{background:var(--hover)}
.ib:disabled{opacity:.35;cursor:default;background:transparent}
.ib[aria-pressed="true"]{background:var(--accent);color:var(--accent-ink)}
.ib.txt{font-weight:700;font-size:15px}
.ib.danger{color:var(--danger)}
.zl{border:0;background:transparent;border-radius:6px;padding:6px 4px;min-width:50px;font-variant-numeric:tabular-nums}
.zl:hover{background:var(--hover)}
.pnav{display:flex;align-items:center;gap:4px;color:var(--muted);font-variant-numeric:tabular-nums}
.pnav input{width:42px;text-align:center;border:1px solid var(--line);border-radius:6px;background:var(--chrome);padding:5px 2px}
.btn{display:inline-flex;align-items:center;gap:6px;border:1px solid var(--line);background:var(--chrome);border-radius:8px;padding:8px 12px;font-weight:600}
.btn:hover{background:var(--chrome2)}
.btn.primary{background:var(--accent);border-color:var(--accent);color:var(--accent-ink)}
.btn.primary:hover{filter:brightness(.96)}
.btn.small{padding:6px 10px;font-size:13px}

/* tool rail */
.rail{display:flex;align-items:center;gap:2px;padding:5px 8px;border-bottom:1px solid var(--line);overflow-x:auto;scrollbar-width:none;min-height:50px}
.rail::-webkit-scrollbar{display:none}
.tool{display:inline-flex;align-items:center;justify-content:center;width:38px;height:38px;border:0;border-radius:9px;background:transparent;flex:none}
.tool:hover{background:var(--hover)}
.tool[aria-pressed="true"]{background:var(--accent);color:var(--accent-ink)}
.sep{width:1px;height:24px;background:var(--line);margin:0 6px;flex:none}
.stylebar{display:flex;align-items:center;gap:4px;flex:none}
.grp{display:flex;align-items:center;gap:4px;flex:none;padding-right:6px}
.swatches{display:flex;gap:4px}
.swb{width:22px;height:22px;border-radius:50%;border:2px solid var(--chrome);box-shadow:0 0 0 1px var(--line);padding:0}
.swb[aria-pressed="true"]{box-shadow:0 0 0 2px var(--ink)}
.cpick{position:relative;width:24px;height:24px;border-radius:50%;overflow:hidden;box-shadow:0 0 0 1px var(--line);background:conic-gradient(#f44,#fd4,#4d6,#4cf,#46f,#c4f,#f44)}
.cpick input{position:absolute;inset:-6px;opacity:0;cursor:pointer}
.stylebar select{border:1px solid var(--line);background:var(--chrome);border-radius:7px;padding:6px 6px;height:34px}

/* main layout */
main{flex:1;display:flex;min-height:0;position:relative}
.side{width:176px;flex:none;border-right:1px solid var(--line);background:var(--chrome2);display:flex;flex-direction:column;min-height:0}
.pageacts{display:flex;flex-wrap:wrap;gap:1px;padding:6px;border-bottom:1px solid var(--line)}
.pageacts .ib{width:32px;height:32px}
.thumbs{flex:1;overflow:auto;padding:8px 6px 24px;display:flex;flex-direction:column;align-items:center;gap:4px}
.thumb{display:flex;flex-direction:column;align-items:center;gap:4px;padding:6px;border-radius:9px;border:2px solid transparent;background:transparent;width:100%}
.thumb:hover{background:var(--hover)}
.thumb.cur{border-color:var(--accent)}
.tbox{width:120px;height:150px;display:flex;align-items:center;justify-content:center}
.tbox canvas{max-width:100%;max-height:100%;background:#fff;box-shadow:0 1px 3px rgba(0,0,0,.25)}
.tbox .ph{width:96px;height:124px;background:#fff;opacity:.6;box-shadow:0 1px 3px rgba(0,0,0,.2)}
.tnum{font-size:12px;color:var(--muted);font-variant-numeric:tabular-nums}

#scroller{flex:1;overflow:auto;position:relative;background:var(--desk);touch-action:pan-x pan-y;min-width:0}
#viewer{width:max-content;min-width:100%;margin:0 auto;padding:20px 16px 80px;display:flex;flex-direction:column;align-items:center;gap:18px;transform-origin:0 0}
.pg{position:relative;flex:none;background:#fff;box-shadow:var(--shadow);user-select:none;-webkit-user-select:none;-webkit-touch-callout:none}
.pg.lock{touch-action:none}
.pgin{position:absolute;transform-origin:center center}
.pgin canvas{position:absolute;left:0;top:0;width:100%;height:100%}
#viewer[data-tool="select"] .pg{cursor:default}
#viewer[data-tool="text"] .pg{cursor:text}
#viewer:not([data-tool="select"]):not([data-tool="text"]) .pg{cursor:crosshair}
.ted{position:absolute;z-index:3;margin:0;padding:0;border:0;outline:1.5px dashed var(--focus);outline-offset:2px;background:rgba(255,255,255,.75);
  white-space:pre;overflow:hidden;resize:none;transform-origin:0 0;min-width:30px;color-scheme:light}

.empty{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;padding:24px}
.drop{max-width:440px;width:100%;text-align:left;padding:34px 30px;border-radius:14px;background:var(--chrome);box-shadow:var(--shadow);border:2px dashed transparent}
.drop.over{border-color:var(--focus)}
.drop h1{font-size:30px;line-height:1.1;letter-spacing:-.02em;margin:0 0 10px}
.drop h1 span{background:linear-gradient(transparent 58%,var(--accent) 58%,var(--accent) 92%,transparent 92%)}
.drop p{color:var(--muted);margin:0 0 22px;max-width:36em}
.drop .row{display:flex;gap:8px;flex-wrap:wrap}
.drop small{display:block;margin-top:18px;color:var(--muted)}

/* right panel */
.panel{width:320px;flex:none;border-left:1px solid var(--line);background:var(--chrome);display:flex;flex-direction:column;min-height:0}
.tabs{display:flex;align-items:center;gap:2px;padding:6px;border-bottom:1px solid var(--line)}
.tabs button[data-tab]{border:0;background:transparent;padding:7px 9px;border-radius:7px;font-weight:500;color:var(--muted)}
.tabs button[data-tab]:hover{background:var(--hover)}
.tabs button[aria-selected="true"]{color:var(--ink);background:var(--chrome2);font-weight:600}
.tabs .ib{margin-left:auto}
.tabbody{flex:1;overflow:auto;padding:14px}
.tabbody h3{font-size:13px;font-weight:600;margin:18px 0 8px}
.tabbody h3:first-child{margin-top:0}
.muted{color:var(--muted)}
.field{display:flex;flex-direction:column;gap:4px;margin-bottom:10px}
.field>span{font-size:12.5px;color:var(--muted)}
.field input[type=text],.field input[type=search],.field select,.field textarea,.tabbody input[type=search]{border:1px solid var(--line);background:var(--chrome);border-radius:7px;padding:8px 9px;width:100%}
.field input[type=range]{width:100%;accent-color:var(--focus)}
.chk{display:flex;align-items:center;gap:8px;margin:8px 0}
.chk input{width:16px;height:16px;accent-color:var(--focus)}
.reslist{list-style:none;padding:0;margin:10px 0 0;display:flex;flex-direction:column;gap:2px}
.reslist button{width:100%;text-align:left;border:0;background:transparent;border-radius:7px;padding:7px 8px;display:flex;flex-direction:column;gap:2px}
.reslist button:hover{background:var(--hover)}
.reslist .pgref{font-size:12px;color:var(--muted)}
.reslist .snip{overflow:hidden;text-overflow:ellipsis;white-space:nowrap;max-width:100%}
.citem{display:flex;align-items:center;gap:4px}
.citem>button:first-child{flex:1;min-width:0}
.note-hint{font-size:12.5px;color:var(--muted);margin-top:6px}
.frm-src{font-weight:600;margin:4px 0 8px}

/* modal + toast */
.modal-back{position:fixed;inset:0;background:rgba(10,14,18,.45);display:flex;align-items:center;justify-content:center;padding:16px;z-index:50}
.modal{background:var(--chrome);color:var(--ink);border-radius:14px;box-shadow:0 20px 60px rgba(0,0,0,.35);width:min(480px,100%);max-height:calc(100% - 32px);overflow:auto;padding:20px}
.modal h2{font-size:18px;margin:0 0 14px;letter-spacing:-.01em}
.modal .fields label{display:flex;flex-direction:column;gap:4px;margin-bottom:12px}
.modal .fields label span{font-size:12.5px;color:var(--muted)}
.modal input[type=text],.modal input[type=password],.modal select,.modal textarea{border:1px solid var(--line);background:var(--chrome2);border-radius:8px;padding:9px 10px;width:100%}
.modal-actions{display:flex;justify-content:flex-end;gap:8px;margin-top:16px;flex-wrap:wrap}
.segs{display:flex;gap:4px;margin-bottom:12px;background:var(--chrome2);padding:3px;border-radius:9px;width:max-content}
.segs button{border:0;background:transparent;padding:6px 12px;border-radius:7px;font-weight:500}
.segs button[aria-pressed="true"]{background:var(--chrome);box-shadow:0 1px 2px rgba(0,0,0,.15)}
.sigpad{width:100%;aspect-ratio:3/1;background:#fff;border-radius:10px;border:1px solid var(--line);touch-action:none;display:block}
.sigrow{display:flex;gap:8px;align-items:center;margin-top:8px;flex-wrap:wrap}
.saved{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:12px}
.saved button{background:#fff;border:1px solid var(--line);border-radius:8px;padding:4px;height:52px;width:120px}
.saved img{max-width:100%;max-height:100%}
.stamps{display:grid;grid-template-columns:repeat(2,1fr);gap:8px}
.stamps button{background:#fff;border:2.5px solid currentColor;border-radius:4px;padding:10px;font:700 15px Helvetica,Arial,sans-serif;letter-spacing:.04em}
#toast{position:fixed;left:50%;bottom:calc(20px + env(safe-area-inset-bottom,0px));transform:translateX(-50%);background:var(--ink);color:var(--chrome);padding:10px 16px;border-radius:10px;box-shadow:0 8px 24px rgba(0,0,0,.25);z-index:60;max-width:calc(100% - 32px);font-weight:500}

@media (max-width:820px){
  .side,.panel{position:absolute;top:0;bottom:0;z-index:20;box-shadow:0 0 40px rgba(0,0,0,.3)}
  .side{left:0;width:min(196px,70vw)}
  .panel{right:0;width:min(360px,94vw)}
  .brand span{display:none}
}
@media (max-width:620px){
  .pnav,.zoom,.bsave-label{display:none!important}
  .docname{flex:1 1 auto;width:auto}
  .btn.primary{padding:8px 10px}
}
@media (prefers-reduced-motion: reduce){*{scroll-behavior:auto!important}}
</style>
</head>
<body>
<header class="top">
  <button class="ib" id="bSide" title="Pages" aria-label="Show or hide pages"></button>
  <div class="brand"><i></i><span>Folio</span></div>
  <input id="docName" class="docname" placeholder="Untitled" aria-label="File name" spellcheck="false" autocomplete="off">
  <div class="spacer"></div>
  <div class="hgrp">
    <button class="ib" id="bUndo" title="Undo (Ctrl+Z)" aria-label="Undo" disabled></button>
    <button class="ib" id="bRedo" title="Redo (Ctrl+Shift+Z)" aria-label="Redo" disabled></button>
  </div>
  <div class="hgrp zoom">
    <button class="ib" id="bZo" title="Zoom out" aria-label="Zoom out"></button>
    <button class="zl" id="zoomLbl" title="Fit to width">100%</button>
    <button class="ib" id="bZi" title="Zoom in" aria-label="Zoom in"></button>
  </div>
  <div class="pnav"><input id="pageNum" inputmode="numeric" aria-label="Current page"><span id="pageTot">/ 0</span></div>
  <button class="ib" id="bOpen" title="Open a file" aria-label="Open a file"></button>
  <button class="ib" id="bPanel" title="Find, comments, forms and document settings" aria-label="Show side panel"></button>
  <button class="btn primary" id="bSave" title="Save PDF (Ctrl+S)"><span id="saveIc"></span><span class="bsave-label">Save PDF</span></button>
</header>

<div class="rail" id="rail" role="toolbar" aria-label="Editing tools">
  <div id="tools" style="display:flex;gap:2px;flex:none"></div>
  <div class="sep" id="styleSep"></div>
  <div class="stylebar" id="stylebar">
    <div class="grp" id="gColor"><div class="swatches" id="swatches"></div><label class="cpick" title="Custom color"><input type="color" id="cColor" aria-label="Custom color"></label></div>
    <div class="grp" id="gWidth"><select id="sWidth" aria-label="Line thickness"></select></div>
    <div class="grp" id="gText"><select id="sFont" aria-label="Font"></select><select id="sSize" aria-label="Font size"></select><button class="ib txt" id="bBold" aria-pressed="false" title="Bold" aria-label="Bold">B</button></div>
    <div class="grp" id="gFill"><button class="ib" id="bFill" aria-pressed="false" title="Fill shape" aria-label="Fill shape"></button></div>
    <div class="grp" id="gSel"><button class="ib" id="bDup" title="Duplicate" aria-label="Duplicate"></button><button class="ib danger" id="bDel" title="Delete (Del)" aria-label="Delete"></button></div>
  </div>
</div>

<main>
  <aside class="side" id="side" aria-label="Pages">
    <div class="pageacts" id="pageacts"></div>
    <div class="thumbs" id="thumbs"></div>
  </aside>
  <section id="scroller">
    <div id="viewer" data-tool="select"></div>
    <div class="empty" id="empty">
      <div class="drop" id="drop">
        <h1>Edit any PDF <span>right here</span></h1>
        <p>Add text, highlight, draw, sign, fill forms, redact, and rearrange pages. Files stay on this device while you edit.</p>
        <div class="row">
          <button class="btn primary" id="eOpen">Open PDF</button>
          <button class="btn" id="eBlank">Start with a blank page</button>
        </div>
        <small>You can also drop a PDF or image anywhere on this screen.</small>
      </div>
    </div>
  </section>
  <aside class="panel" id="panel" hidden aria-label="Tools panel">
    <div class="tabs" role="tablist">
      <button data-tab="find" role="tab">Find</button>
      <button data-tab="comments" role="tab">Comments</button>
      <button data-tab="forms" role="tab">Forms</button>
      <button data-tab="doc" role="tab">Document</button>
      <button class="ib" id="bPanelX" aria-label="Close panel"></button>
    </div>
    <div class="tabbody" data-body="find">
      <input type="search" id="q" placeholder="Search this document" aria-label="Search text">
      <label class="chk"><input type="checkbox" id="qCase"> Match case</label>
      <div id="findInfo" class="muted"></div>
      <button class="btn small" id="bHlAll" hidden style="margin-top:8px">Highlight all matches</button>
      <ol class="reslist" id="findRes"></ol>
    </div>
    <div class="tabbody" data-body="comments" hidden><div id="cmtList"></div></div>
    <div class="tabbody" data-body="forms" hidden><div id="formsBody"></div></div>
    <div class="tabbody" data-body="doc" hidden>
      <h3>Properties</h3>
      <label class="field"><span>Title</span><input type="text" id="mTitle"></label>
      <label class="field"><span>Author</span><input type="text" id="mAuthor"></label>
      <h3>Watermark</h3>
      <label class="field"><span>Text</span><input type="text" id="wText" placeholder="e.g. DRAFT"></label>
      <label class="field"><span>Size</span><input type="range" id="wSize" min="24" max="160" value="64"></label>
      <label class="field"><span>Opacity</span><input type="range" id="wOp" min="5" max="60" value="15"></label>
      <h3>Page numbers</h3>
      <label class="field"><span>Show at the bottom of each page</span>
        <select id="pnMode"><option value="off">Off</option><option value="n">1</option><option value="page">Page 1</option><option value="of">Page 1 of 10</option></select></label>
      <h3>About saving</h3>
      <p class="muted" style="margin:0">Pages with redactions are saved as images, so the hidden text is removed for good. Everything else stays as selectable text.</p>
      <p class="muted" id="docInfo"></p>
    </div>
  </aside>
</main>
<input type="file" id="fileIn" accept="application/pdf,.pdf,image/*" multiple hidden>
<input type="file" id="imgIn" accept="image/*" hidden>
<div id="toast" hidden role="status" aria-live="polite"></div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.worker.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/pdf-lib/1.17.1/pdf-lib.min.js"></script>
