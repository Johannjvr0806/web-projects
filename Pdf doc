const baseName = () => (($('#docName').value || S.name || 'document').trim().replace(/\.pdf$/i, '').replace(/[\\/:*?"<>|]+/g, '-') || 'document');
let dlP = null;
function getDownloads() { if (!dlP) dlP = (window.claude && typeof window.claude.use === 'function') ? Promise.resolve(window.claude.use('downloads')).catch(() => null) : Promise.resolve(null); return dlP; }
function fallbackDownload(blob, name) { const u = URL.createObjectURL(blob); const a = h('a', {href:u, download:name}); document.body.append(a); a.click(); a.remove(); setTimeout(() => URL.revokeObjectURL(u), 4000); toast('Download started.'); }
async function deliver(bytes, filename) {
  const blob = new Blob([bytes], {type:'application/pdf'}); const dl = await getDownloads();
  if (!dl) return fallbackDownload(blob, filename);
  try { await dl.save({filename, data:blob}); toast(`Saved ${filename}`); S.dirty = false; }
  catch (e) { const c = e && e.code; if (c === 'declined') toast('Save canceled.'); else if (c === 'rate_limited') toast('A save prompt is already open.'); else fallbackDownload(blob, filename); }
}
async function save() {
  if (!S.pages.length) return toast('Open a PDF first.'); closeEditor(); toast('Building your PDF…', 0);
  try { const bytes = await buildPdf(S.pages.map((_, i) => i)); await deliver(bytes, baseName() + '.pdf'); }
  catch (e) { console.error(e); toast('Couldn’t build the PDF. ' + (e.message || ''), 6000); }
}

/* ---------- panel: find / comments / forms / document ---------- */
function openPanel(tab) { const pn = $('#panel'); pn.hidden = false; if (innerWidth <= 820) toggleSide(false); setTab(tab || S.tab); }
function setTab(tab) { S.tab = tab; $$('.tabs [data-tab]').forEach(b => b.setAttribute('aria-selected', b.dataset.tab === tab ? 'true' : 'false')); $$('.tabbody').forEach(b => b.hidden = b.dataset.body !== tab); renderTab(); if (tab === 'find') setTimeout(() => $('#q').focus(), 30); }
function renderTab() { if (S.tab === 'comments') renderComments(); else if (S.tab === 'forms') renderForms(); else if (S.tab === 'doc') refreshDocPanel(); }
$$('.tabs [data-tab]').forEach(b => b.addEventListener('click', () => setTab(b.dataset.tab)));
$('#bPanelX').addEventListener('click', () => { $('#panel').hidden = true; });

let findTok = 0, findT;
async function textOf(p) {
  const s = p.src >= 0 ? S.srcs[p.src] : null; if (!s || s.kind !== 'pdf') return null;
  if (!s.text[p.sp]) { try { s.text[p.sp] = (await (await s.pdf.getPage(p.sp + 1)).getTextContent()).items; } catch (e) { s.text[p.sp] = []; } }
  return s.text[p.sp];
}
async function runFind() {
  const q = $('#q').value, mc = $('#qCase').checked, tok = ++findTok; const old = S.hits; S.hits = {};
  for (const id in old) { const p = P(id); if (p) drawOverlay(p); }
  const res = []; const list = $('#findRes'); list.replaceChildren(); $('#bHlAll').hidden = true;
  if (!q.trim()) { $('#findInfo').textContent = ''; return; }
  $('#findInfo').textContent = 'Searching…'; const ql = mc ? q : q.toLowerCase();
  for (let i = 0; i < S.pages.length; i++) {
    const p = S.pages[i], items = await textOf(p); if (tok !== findTok) return; if (!items) continue;
    for (const it of items) { if (!it.str) continue; const s = mc ? it.str : it.str.toLowerCase(); let k = s.indexOf(ql);
      while (k >= 0) { const t = it.transform, fh = Math.hypot(t[2], t[3]) || Math.hypot(t[0], t[1]) || 10, len = it.str.length;
        const r = {x: t[4] - p.view[0] + it.width * k / len, y: p.view[3] - t[5] - fh * .85, w: it.width * q.length / len, h: fh * 1.1};
        (S.hits[p.id] = S.hits[p.id] || []).push(r); res.push({i, pid:p.id, snip:it.str}); k = s.indexOf(ql, k + ql.length); } }
    if (S.hits[p.id]) drawOverlay(p);
  }
  $('#findInfo').textContent = res.length ? `${res.length} match${res.length > 1 ? 'es' : ''}` : (S.srcs.some(s => s.kind === 'pdf') ? 'No matches. Scanned pages have no searchable text.' : 'No matches.');
  $('#bHlAll').hidden = !res.length;
  list.replaceChildren(...res.slice(0, 300).map(r => h('li', {}, h('button', {onclick:() => { goTo(r.i, true); if (innerWidth <= 820) $('#panel').hidden = true; }}, h('span', {class:'pgref'}, `Page ${r.i + 1}`), h('span', {class:'snip'}, r.snip)))));
}
$('#q').addEventListener('input', () => { clearTimeout(findT); findT = setTimeout(runFind, 250); });
$('#q').addEventListener('keydown', e => { if (e.key === 'Enter') { clearTimeout(findT); runFind(); } });
$('#qCase').addEventListener('change', runFind);
$('#bHlAll').addEventListener('click', () => {
  snap(); let n = 0; for (const [id, rs] of Object.entries(S.hits)) { const p = P(id); if (!p) continue; for (const r of rs) { p.annots.push({id:nid(), type:'hl', x:r.x, y:r.y, w:r.w, h:r.h, color:S.style.hl}); n++; } markDirty(p); }
  S.hits = {}; redrawAll(); $('#bHlAll').hidden = true; toast(`Highlighted ${n} match${n > 1 ? 'es' : ''}.`);
});

function renderComments() {
  const box = $('#cmtList'); const items = [];
  S.pages.forEach((p, i) => p.annots.forEach(a => items.push({p, i, a})));
  if (!items.length) { box.replaceChildren(h('p', {class:'muted'}, 'No markup yet. Notes, text, highlights, and drawings you add will be listed here.')); return; }
  box.replaceChildren(h('ol', {class:'reslist'}, items.map(({p, i, a}) => h('li', {class:'citem'},
    h('button', {onclick:() => { goTo(i, true); setTool('select'); setSel(a.id); }}, h('span', {class:'pgref'}, `${TYPE_LABEL[a.type]} on page ${i + 1}`),
      h('span', {class:'snip'}, a.type === 'note' || a.type === 'text' || a.type === 'stamp' ? (a.text || '(empty)') : '')),
    h('button', {class:'ib danger', title:'Delete', 'aria-label':'Delete', html:ic('trash'), onclick:() => { snap(); p.annots.splice(p.annots.indexOf(a), 1); if (S.sel === a.id) S.sel = null; drawOverlay(p); markDirty(p); renderComments(); renderStyle(); }}))))) ;
}

function describeField(f) {
  try {
    const name = f.getName();
    if (f instanceof L.PDFTextField) return {name, kind:'text', value:f.getText() || '', multi:f.isMultiline()};
    if (f instanceof L.PDFCheckBox) return {name, kind:'check', value:f.isChecked()};
    if (f instanceof L.PDFDropdown || f instanceof L.PDFOptionList) return {name, kind:'select', options:f.getOptions(), value:(f.getSelected() || [])[0] || ''};
    if (f instanceof L.PDFRadioGroup) return {name, kind:'select', options:f.getOptions(), value:f.getSelected() || ''};
  } catch (e) {}
  return null;
}
async function renderForms() {
  const box = $('#formsBody'); box.replaceChildren(h('p', {class:'muted'}, 'Looking for form fields…'));
  const groups = [];
  for (let si = 0; si < S.srcs.length; si++) { const s = S.srcs[si]; if (s.kind !== 'pdf' || s.raster) continue;
    if (!s.fields) { try { const d = await L.PDFDocument.load(s.bytes); s.fields = d.getForm().getFields().map(describeField).filter(Boolean); } catch (e) { s.fields = []; } }
    if (s.fields.length) groups.push([si, s]); }
  if (!groups.length) { box.replaceChildren(h('p', {class:'muted'}, 'This document has no fillable form fields. Use the Add text tool to type anywhere on a page instead.')); return; }
  box.replaceChildren(...groups.map(([si, s]) => {
    const lock = h('input', {type:'checkbox'});
    return h('div', {style:'margin-bottom:22px'}, groups.length > 1 ? h('div', {class:'frm-src'}, s.name) : null,
      ...s.fields.map(f => {
        let el;
        if (f.kind === 'check') { el = h('input', {type:'checkbox'}); el.checked = f.value; el.onchange = () => f.value = el.checked; return h('label', {class:'chk'}, el, f.name); }
        if (f.kind === 'select') { el = h('select', {}, h('option', {value:''}, '—'), f.options.map(o => h('option', {value:o}, o))); el.value = f.value; el.onchange = () => f.value = el.value; }
        else { el = f.multi ? h('textarea', {rows:3}) : h('input', {type:'text'}); el.value = f.value; el.oninput = () => f.value = el.value; }
        return h('label', {class:'field'}, h('span', {}, f.name), el);
      }),
      h('label', {class:'chk'}, lock, 'Lock fields after filling'),
      h('button', {class:'btn primary', onclick:() => applyForms(si, lock.checked)}, 'Apply to document'));
  }));
}
async function applyForms(si, flatten) {
  const s = S.srcs[si]; toast('Filling the form…', 0);
  try {
    const d = await L.PDFDocument.load(s.bytes); const form = d.getForm();
    for (const f of s.fields) { try { const fld = form.getField(f.name);
      if (fld instanceof L.PDFTextField) fld.setText(f.value || undefined);
      else if (fld instanceof L.PDFCheckBox) f.value ? fld.check() : fld.uncheck();
      else if (f.value && (fld instanceof L.PDFDropdown || fld instanceof L.PDFOptionList || fld instanceof L.PDFRadioGroup)) fld.select(f.value);
    } catch (e) { console.warn('field', f.name, e); } }
    if (flatten) form.flatten();
    s.bytes = await d.save(); try { s.pdf.destroy(); } catch (e) {}
    s.pdf = await openPdfjs(s.bytes); s.n = s.pdf.numPages; s.text = {}; s.fields = null; S.dirty = true;
    for (const p of S.pages) if (p.src === si) { const o = pageEls.get(p.id); if (o) { o.rz = 0; if (o.vis) ensure(p); } thumbDirty(p); }
    toast(flatten ? 'Form filled and locked.' : 'Form filled. Save the PDF to keep it.'); renderForms();
  } catch (e) { console.error(e); toast('Couldn’t fill this form. ' + (e.message || '')); }
}

function refreshDocPanel() {
  $('#mTitle').value = S.meta.title || ''; $('#mAuthor').value = S.meta.author || '';
  $('#wText').value = S.wm.text; $('#wSize').value = S.wm.size; $('#wOp').value = Math.round(S.wm.opacity * 100); $('#pnMode').value = S.pn.mode;
  const kb = S.srcs.reduce((n, s) => n + (s.bytes ? s.bytes.length : 0), 0) / 1024;
  $('#docInfo').textContent = S.pages.length ? `${S.pages.length} page${S.pages.length > 1 ? 's' : ''}, about ${kb > 1024 ? (kb / 1024).toFixed(1) + ' MB' : Math.max(1, Math.round(kb)) + ' KB'} of source files.` : '';
}
let extrasT; const extrasChanged = () => { S.dirty = true; redrawAll(); clearTimeout(extrasT); extrasT = setTimeout(() => S.pages.forEach(thumbDirty), 400); };
$('#mTitle').addEventListener('input', e => S.meta.title = e.target.value);
$('#mAuthor').addEventListener('input', e => S.meta.author = e.target.value);
$('#wText').addEventListener('input', e => { S.wm.text = e.target.value; extrasChanged(); });
$('#wSize').addEventListener('input', e => { S.wm.size = +e.target.value; extrasChanged(); });
$('#wOp').addEventListener('input', e => { S.wm.opacity = +e.target.value / 100; extrasChanged(); });
$('#pnMode').addEventListener('change', e => { S.pn.mode = e.target.value; extrasChanged(); });

/* ---------- wiring ---------- */
$('#tools').append(...TOOLS.map(([t, label, key]) => h('button', {class:'tool', 'data-t':t, title:`${label} (${key})`, 'aria-label':label, 'aria-pressed': t === 'select' ? 'true' : 'false', html:ic(t), onclick:() => pickTool(t)})));
[['#bSide', 'pages'], ['#bUndo', 'undo'], ['#bRedo', 'redo'], ['#bZo', 'minus'], ['#bZi', 'plus'], ['#bOpen', 'open'], ['#bPanel', 'panel'], ['#bPanelX', 'close'], ['#bDel', 'trash'], ['#bDup', 'dup'], ['#bFill', 'fill']].forEach(([s, n]) => $(s).innerHTML = ic(n));
$('#saveIc').outerHTML = ic('save');
function toggleSide(force) { const sd = $('#side'); const show = force ?? sd.hidden; sd.hidden = !show; if (show && innerWidth <= 820) $('#panel').hidden = true; }
$('#bSide').addEventListener('click', () => toggleSide());
$('#bPanel').addEventListener('click', () => { const pn = $('#panel'); if (pn.hidden) openPanel(); else pn.hidden = true; });
$('#bUndo').addEventListener('click', undo); $('#bRedo').addEventListener('click', redo);
$('#bZo').addEventListener('click', () => setZoom(S.zoom / 1.2)); $('#bZi').addEventListener('click', () => setZoom(S.zoom * 1.2));
$('#zoomLbl').addEventListener('click', () => fitWidth(false));
$('#bSave').addEventListener('click', save);
$('#docName').addEventListener('input', e => S.name = e.target.value);
$('#pageNum').addEventListener('change', e => { const n = parseInt(e.target.value, 10); if (n >= 1 && n <= S.pages.length) goTo(n - 1); else updPageNav(); });

let pickMode = 'replace';
function openPicker(mode) { pickMode = mode; $('#fileIn').click(); }
$('#fileIn').addEventListener('change', e => { const f = Array.from(e.target.files); e.target.value = ''; openFiles(f, pickMode); });
$('#bOpen').addEventListener('click', async () => {
  if (!S.pages.length) return openPicker('replace');
  const r = await modal('Open a file', h('p', {class:'muted', style:'margin:0'}, 'Add its pages after the current page, or open it on its own. Opening on its own closes this document, so save first if you want to keep your changes.'),
    [{label:'Cancel'}, {label:'Open on its own', value:'replace'}, {label:'Add pages', primary:true, value:'insert'}]);
  if (r) openPicker(r);
});
$('#eOpen').addEventListener('click', () => openPicker('replace'));
$('#eBlank').addEventListener('click', newBlank);

// drag & drop
let dragDepth = 0;
document.addEventListener('dragenter', e => { if (e.dataTransfer && Array.from(e.dataTransfer.types).includes('Files')) { e.preventDefault(); dragDepth++; $('#drop').classList.add('over'); } });
document.addEventListener('dragleave', () => { dragDepth = Math.max(0, dragDepth - 1); if (!dragDepth) $('#drop').classList.remove('over'); });
document.addEventListener('dragover', e => e.preventDefault());
document.addEventListener('drop', e => { e.preventDefault(); dragDepth = 0; $('#drop').classList.remove('over'); const f = e.dataTransfer && e.dataTransfer.files; if (f && f.length) openFiles(f, S.pages.length ? 'insert' : 'replace'); });

let lastNudge = 0;
document.addEventListener('keydown', e => {
  if (document.querySelector('.modal-back')) return;
  const tg = e.target, typing = /^(INPUT|TEXTAREA|SELECT)$/.test(tg.tagName) || tg.isContentEditable, mod = e.ctrlKey || e.metaKey, k = e.key.toLowerCase();
  if (mod && k === 's') { e.preventDefault(); save(); return; }
  if (mod && k === 'f') { e.preventDefault(); openPanel('find'); return; }
  if (typing) return;
  if (mod && k === 'z') { e.preventDefault(); e.shiftKey ? redo() : undo(); return; }
  if (mod && k === 'y') { e.preventDefault(); redo(); return; }
  if (mod && k === 'd' && S.sel) { e.preventDefault(); dupSel(); return; }
  if ((e.key === 'Delete' || e.key === 'Backspace') && S.sel) { e.preventDefault(); delSel(); return; }
  if (e.key === 'Escape') { setSel(null); setTool('select'); return; }
  if (S.sel && e.key.startsWith('Arrow')) {
    e.preventDefault(); const s = selAnnot(); const st = (e.shiftKey ? 10 : 1);
    let [dx, dy] = {ArrowLeft:[-st, 0], ArrowRight:[st, 0], ArrowUp:[0, -st], ArrowDown:[0, st]}[e.key];
    const p = s.p, [u0, v0] = d2u(p, 0, 0), [u1, v1] = d2u(p, dx, dy);
    if (performance.now() - lastNudge > 700) snap(); lastNudge = performance.now();
    moveAnnot(s.a, clone(s.a), u1 - u0, v1 - v0); drawOverlay(p); markDirty(p); return;
  }
  if (!mod && !e.altKey && S.pages.length) { const t = TOOLS.find(x => x[2].toLowerCase() === k); if (t) { e.preventDefault(); pickTool(t[0]); } }
});
window.addEventListener('resize', () => { if (innerWidth > 820 && $('#side').hidden && S.pages.length && !sideClosedByUser) $('#side').hidden = false; });
let sideClosedByUser = false;
$('#bSide').addEventListener('click', () => { sideClosedByUser = $('#side').hidden; });

// initial
if (innerWidth <= 820) $('#side').hidden = true;
setTool('select'); updUndo(); updPageNav(); syncAll(); setTab('find'); $('#panel').hidden = true;
})();
</script>
